{
  "github": {
    "release": true,
    "releaseName": "v${version}"
  },
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": true
  },
  "npm": {
    "publish": true,
    "access": "public"
  },
  "hooks": {
    "before:init": ["yarn lint", "yarn check", "yarn bob build"]
  }
}
